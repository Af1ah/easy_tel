# No Telegram/rclone credentials belong in this file.
# Keep these values aligned with the media settings in the bot's .env.
TEL_STATE_DIR=/opt/easy_tel/state
TEL_MEDIA_BASE_URL=https://tv.ariise.cloud
TEL_MEDIA_TTL_SECONDS=86400
TEL_MEDIA_MAX_BYTES=42949672960
TEL_DISK_RESERVE_BYTES=1073741824
TEL_MEDIA_THREADS=2
TEL_MEDIA_MAX_HEIGHT=1080
