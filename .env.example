TEL_APPID=
TEL_APP_HASH=
TEL_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Empty means no transfers allowed.
TEL_ALLOWED_USER_IDS=1142095919
TEL_EXPECTED_BOT_USERNAME=easy_tel2_bot
TEL_DRIVE_DEST=gdrive:easy_tel
TEL_STATE_DIR=./state
TEL_MAX_FILE_BYTES=4294967296
TEL_DISK_RESERVE_BYTES=1073741824
TEL_MAX_QUEUE=20
# Concurrent chunk requests for documents >= 32 MiB. Range: 1–8.
# Set 1 for the standard downloader. Failed job retries reduce concurrency.
TEL_DOWNLOAD_WORKERS=4
TEL_PARALLEL_MIN_BYTES=33554432
# Includes the initial try. Retry state survives service restarts.
TEL_MAX_ATTEMPTS=4
TEL_RETRY_BASE_SECONDS=15
# Edits are coalesced; minimum effective interval is 1 second.
TEL_PROGRESS_INTERVAL=1
# Optional path to the VPS's existing authenticated rclone configuration.
# RCLONE_CONFIG=/home/your-user/.config/rclone/rclone.conf

# Optional browser player. Keep 0 until HTTPS and easy-tel-media are configured.
TEL_MEDIA_ENABLED=0
TEL_MEDIA_BASE_URL=https://tel.aflahdev.me
TEL_MEDIA_TTL_SECONDS=86400
# Total media cache budget, including originals, HLS, and queued reservations: 40 GiB.
TEL_MEDIA_MAX_BYTES=42949672960
# One preparation job runs at a time; these control that job, not each viewer.
TEL_MEDIA_THREADS=2
TEL_MEDIA_MAX_HEIGHT=1080
