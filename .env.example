TEL_APPID=
TEL_APP_HASH=
TEL_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Empty means no transfers allowed.
TEL_ALLOWED_USER_IDS=1142095919
TEL_EXPECTED_BOT_USERNAME=easy_tel2_bot
TEL_DRIVE_DEST=gdrive:easy_tel
TEL_STATE_DIR=./state
TEL_MAX_FILE_BYTES=4294967296
TEL_DISK_RESERVE_BYTES=1073741824
TEL_MAX_QUEUE=20
# Includes the initial try. Retry state survives service restarts.
TEL_MAX_ATTEMPTS=4
TEL_RETRY_BASE_SECONDS=15
# Edits are coalesced; minimum effective interval is 3 seconds.
TEL_PROGRESS_INTERVAL=5
# Optional path to the VPS's existing authenticated rclone configuration.
# RCLONE_CONFIG=/home/your-user/.config/rclone/rclone.conf
